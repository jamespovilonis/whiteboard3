{
  "name": "whiteboard-3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5500",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5500",
    "test:e2e": "playwright test",
    "test:e2e:real": "REAL_OCR_E2E=1 VITE_OCR_API_URL=http://127.0.0.1:8010 playwright test e2e/real-reader-smoke.spec.js e2e/real-reader-matrix.spec.js --project=chromium --workers=1",
    "test:e2e:real:smoke": "REAL_OCR_E2E=1 VITE_OCR_API_URL=http://127.0.0.1:8010 playwright test e2e/real-reader-smoke.spec.js --project=chromium --workers=1",
    "test:e2e:real:matrix": "REAL_OCR_E2E=1 VITE_OCR_API_URL=http://127.0.0.1:8010 playwright test e2e/real-reader-matrix.spec.js --project=chromium --workers=1",
    "test:e2e:headed": "playwright test --headed",
    "test:segmentation": "python3 -m unittest testing.test_line_segmentation_pipeline testing.test_latex_semantics testing.test_equation_grader && node --test testing/test_recognition_pipeline.mjs",
    "test:segmentation:matrix": "python3 testing/run_segmentation_matrix.py"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
